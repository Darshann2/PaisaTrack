# ---------------------------------------------------------------------------
# PaisaTrack - local environment variables.
# Copy this file to ".env" (same folder) and fill in your values if you want to
# override the Firebase project bundled in firebase-applet-config.json.
# If you leave a variable unset/empty, the value from firebase-applet-config.json is used.
#
# Firebase web config values are public identifiers (NOT secrets). Access to data is
# enforced by firestore.rules. NEVER put a service-account JSON/private key here.
# Find them in: Firebase Console > Project settings (gear) > General > Your apps > Web app > SDK setup and configuration.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firestore database id. This project uses a NAMED database created by Google AI Studio
# (see firebase-applet-config.json "firestoreDatabaseId"). Use "(default)" for the default one.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
